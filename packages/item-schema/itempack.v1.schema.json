{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SharingYu/baobao-codex-pet/main/packages/item-schema/itempack.v1.schema.json",
  "title": "Desktop Pet Item Pack Manifest v1",
  "description": "Declarative, data-only props bundle for the Desktop Pet Companion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "manifestVersion", "id", "displayName", "description", "license", "assets", "items"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 256 },
    "format": { "const": "com.petdesktop.itempack" },
    "manifestVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/slug" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "license": { "type": "string", "minLength": 1, "maxLength": 120 },
    "assets": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/asset" } },
    "previewAsset": { "$ref": "#/$defs/slug" },
    "items": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "safePath": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "mediaType", "bytes", "sha256", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "path": { "$ref": "#/$defs/safePath" },
        "mediaType": { "enum": ["image/webp", "image/png"] },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2048 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "category", "behavior", "asset", "scale"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "category": { "enum": ["food", "toy"] },
        "behavior": { "enum": ["treat", "ball", "wand", "hideout"] },
        "asset": { "$ref": "#/$defs/slug" },
        "scale": { "type": "number", "minimum": 0.35, "maximum": 2.5 }
      }
    }
  }
}
