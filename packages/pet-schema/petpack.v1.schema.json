{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SharingYu/baobao-codex-pet/main/packages/pet-schema/petpack.v1.schema.json",
  "title": "Desktop Pet Pack Manifest v1",
  "description": "Declarative, data-only manifest for a portable desktop pet bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifestVersion",
    "id",
    "displayName",
    "description",
    "license",
    "source",
    "assets",
    "renderer",
    "interactions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 256
    },
    "format": {
      "const": "com.baofeifei.petpack"
    },
    "manifestVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "codex-v2"
          ]
        },
        "spriteVersionNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "previewAsset": {
      "$ref": "#/$defs/slug"
    },
    "renderer": {
      "$ref": "#/$defs/spriteAtlasRenderer"
    },
    "interactions": {
      "$ref": "#/$defs/interactions"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "width": [
          "height"
        ],
        "height": [
          "width"
        ]
      },
      "required": [
        "id",
        "path",
        "mediaType",
        "bytes",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "$ref": "#/$defs/safePath"
        },
        "mediaType": {
          "enum": [
            "image/webp",
            "image/png"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "frames",
        "frameDurationsMs",
        "loop"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "frameDurationsMs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 16,
            "maximum": 10000
          }
        },
        "loop": {
          "type": "boolean"
        }
      }
    },
    "lookDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degrees",
        "row",
        "column"
      ],
      "properties": {
        "degrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "multipleOf": 0.5
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "spriteAtlasRenderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "atlasAsset",
        "cellWidth",
        "cellHeight",
        "columns",
        "rows",
        "anchor",
        "defaultScale",
        "animations"
      ],
      "properties": {
        "type": {
          "const": "sprite-atlas"
        },
        "atlasAsset": {
          "$ref": "#/$defs/slug"
        },
        "cellWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "cellHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "defaultScale": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "animations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/animation"
          }
        },
        "lookDirections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/lookDirection"
          }
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventMap"
      ],
      "properties": {
        "eventMap": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/slug"
          }
        },
        "touchZones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/touchZone"
          }
        }
      }
    },
    "touchZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "event": {
          "$ref": "#/$defs/slug"
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
